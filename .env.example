# Copy to `.env` and fill in real values:  cp .env.example .env
# Load into your shell before running the pipeline:  set -a; source .env; set +a
#
# The pipeline reads these from the environment only — never commit real keys.
# `.env` is git-ignored; this `.env.example` template is safe to commit.

# OpenAI — semantic embeddings (text-embedding-3-large), Section 1.4
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — cluster naming / category assignment / coherence judge, Section 2
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
